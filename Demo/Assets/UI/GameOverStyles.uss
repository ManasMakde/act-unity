:root {
    /* shared spacing and sizing variables */
    --game-over-font-size: 32px;
    --game-over-letter-spacing: 4px;
    --bar-padding-vertical: 10px;
    --bar-margin-bottom: 32px;
    --restart-button-width: 160px;
    --restart-button-height: 48px;
    --restart-button-font-size: 20px;
    --restart-button-border-radius: 6px;
    --restart-button-border-width: 2px;
    --bar-background-color: black;
    --root-background-color: rgba(0, 0, 0, 0.7);
    --text-color: white;
    --button-background-color: rgba(30, 30, 30, 0.9);
    --button-hover-background-color: rgba(50, 50, 50, 0.9);
    --button-active-background-color: rgba(70, 70, 70, 0.9);
    --button-border-color: rgba(255, 255, 255, 0.4);
    --transition-duration: 0.15s;
}
.game-over-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--root-background-color);
}
.game-over-bar {
    width: 100%;
    background-color: var(--bar-background-color);
    align-items: center;
    justify-content: center;
    padding-top: var(--bar-padding-vertical);
    padding-bottom: var(--bar-padding-vertical);
    margin-bottom: var(--bar-margin-bottom);
}
.game-over-text {
    font-size: var(--game-over-font-size);
    color: var(--text-color);
    -unity-font-style: bold;
    letter-spacing: var(--game-over-letter-spacing);
    -unity-text-align: middle-center;
}
.restart-button {
    width: var(--restart-button-width);
    height: var(--restart-button-height);
    font-size: var(--restart-button-font-size);
    align-self: center;
    background-color: var(--button-background-color);
    border-radius: var(--restart-button-border-radius);
    border-width: var(--restart-button-border-width);
    border-color: var(--button-border-color);
    color: var(--text-color);
    transition-duration: var(--transition-duration);
}
.restart-button:hover {
    background-color: var(--button-hover-background-color);
}
.restart-button:active {
    background-color: var(--button-active-background-color);
}
